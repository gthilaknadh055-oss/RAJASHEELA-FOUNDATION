const SHEET_NAME = 'Applications';
const FOLDER_NAME = 'Rajasheela Foundation Applications';
function doPost(e){try{const d=JSON.parse(e.postData.contents||'{}');const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(['Timestamp','Full name',"Father's name",'Age','Occupation','Village','Mandal','District','Mobile','Gmail','Service details','Uploaded files']);}const folder=getFolder_();const links=[];(d.uploads||[]).forEach(f=>{const blob=Utilities.newBlob(Utilities.base64Decode(f.base64),f.mimeType,f.name);const saved=folder.createFile(blob);links.push(f.category+': '+saved.getUrl());});sh.appendRow([new Date(),d.fullName||'',d.fatherName||'',d.age||'',d.occupation||'',d.village||'',d.mandal||'',d.district||'',d.mobile||'',d.email||'',d.serviceDetails||'',links.join('\n')]);return json_({success:true});}catch(err){return json_({success:false,message:String(err)});}}
function getFolder_(){const it=DriveApp.getFoldersByName(FOLDER_NAME);return it.hasNext()?it.next():DriveApp.createFolder(FOLDER_NAME);}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
